NODE_ENV=production
HOST=127.0.0.1
PORT=3210
APP_URL=https://video.dymas.cloud
TRUST_PROXY=127.0.0.1

DB_HOST=localhost
DB_PORT=3306
DB_USER=dummy
DB_PASSWORD=
DB_NAME=dummy
DB_SOCKET=/tmp/mysql.sock

# 32 byte acak. JANGAN DIUBAH setelah ada data (enkripsi secret & HMAC).
APP_KEY=base64:GANTI_DENGAN_32_BYTE_BASE64
INTERNAL_TOKEN=GANTI_DENGAN_HEX_ACAK

STORAGE_DIR=/www/wwwroot/video.dymas.cloud/storage
WEB_DIST_DIR=/www/wwwroot/video.dymas.cloud/web/dist
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
LOG_LEVEL=info

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
